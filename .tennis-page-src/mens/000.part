<!doctype html>
<html lang="en" data-tennis-lineage="Men's Singles">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LSC — Men's Lineal Tennis Championship — Hero v2</title>
<style>
:root{
  --bg:#050d14;
  --panel:#091923;
  --panel2:#07131d;
  --cream:#f2ecdf;
  --text:#d6d8d3;
  --muted:#8f9da0;
  --line:#23343b;
  --line2:#345148;
  --gold:#c49a47;
  --gold2:#d5ab55;
  --green:#1f5f46;
  --green2:#3e8b68;
  --green-bright:#7fbea1;
  --max:1180px;
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{
  margin:0;
  color:var(--text);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  background:
    radial-gradient(circle at 50% -10%,#10272a 0,#07131d 35%,#050d14 76%);
  line-height:1.45;
}
.wrap{width:min(var(--max),calc(100% - 44px));margin:auto}
a{color:inherit;text-decoration:none}

/* shared LSC header, Tennis typography */
header{
  position:sticky;top:0;z-index:20;
  background:rgba(4,12,19,.94);
  backdrop-filter:blur(13px);
  border-bottom:1px solid #20303a;
}
.nav{height:62px;display:flex;align-items:center;gap:16px}
.logo{
  width:38px;height:38px;border:1px solid var(--gold);border-radius:50%;
  display:grid;place-items:center;color:var(--gold2);
  font:600 12px Georgia,serif;
}
.brand b{
  display:block;color:var(--cream);
  font:600 16px Georgia,serif;
  letter-spacing:.035em;
}
.brand span{
  font-size:9px;color:var(--green-bright);
  text-transform:uppercase;letter-spacing:.12em;
}
.navlinks{margin-left:auto;display:flex;gap:22px}
.navlinks a{
  color:#bfc6c3;text-decoration:none;font-size:10px;
  text-transform:uppercase;letter-spacing:.08em;
}

/* breadcrumb requested: stop at Tennis */
.crumb{
  padding-top:20px;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.16em;
  color:var(--green-bright);
}

/* Bannerman hierarchy, Tennis visual identity */
.hero{padding:48px 0 34px}
.kicker{
  font-size:9px;text-transform:uppercase;letter-spacing:.16em;
  color:var(--green-bright);font-weight:700;
}
.hero h1{
  font-family:"Cormorant Garamond",Georgia,serif;
  font-size:clamp(44px,6vw,76px);
  line-height:.9;
  font-weight:600;
  margin:8px 0 14px;
  color:var(--cream);
  letter-spacing:-.035em;
}
.hero h1 span{color:var(--gold2)}
.hero p{
  max-width:680px;margin:0;color:#b7c1bf;font-size:14px;
}

/* current holder banner */
.holder-row{
  display:flex;align-items:stretch;margin-top:28px;
  border:1px solid var(--line2);border-radius:14px;overflow:hidden;
  background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));
}
.holder-main{
  display:flex;align-items:center;gap:22px;
  padding:24px 28px;
  border-right:1px solid var(--line);
  flex:1 1 410px;min-width:0;
}

/*
  UNIVERSAL FLAG COMPONENT
  ------------------------
  No flag-specific CSS.
  The outer box is always the same size.
  The image is never stretched or cropped.
  Flags with unusual proportions are centred inside the same box.
*/
.flag-shell{
  width:58px;
  aspect-ratio:5 / 3;
  flex:0 0 58px;
  border-radius:0;
  overflow:visible;
  border:0;
  background:transparent;
  box-shadow:none;
  display:grid;
  place-items:center;
  position:relative;
}
.flag-shell img{
  width:100%;
  height:100%;
  display:block;
  object-fit:contain;
  object-position:center;
  background:#061119;
}
.flag-shell .flag-fallback{
  display:none;
  font:600 17px/1 Inter,sans-serif;
  letter-spacing:.08em;
  color:var(--cream);
}
.flag-shell.is-fallback img{display:none}
.flag-shell.is-fallback .flag-fallback{display:block}

.holder-copy{min-width:0}
.labelrow{display:flex;align-items:center;gap:2px}
.holder-label{
  font-size:9px;text-transform:uppercase;letter-spacing:.16em;
  color:var(--green-bright);font-weight:700;
}
.share{
  width:22px;height:22px;padding:0;border:0;
  background:transparent;color:var(--gold);
  display:grid;place-items:center;cursor:pointer;border-radius:50%;
}
.share:hover{background:rgba(196,154,71,.08);color:var(--gold2)}
.holder-name{
  font:600 clamp(31px,3.2vw,42px)/1 Georgia,serif;
  color:var(--cream);margin-top:4px;
}
.holder-since{font-size:11px;color:#a5b0af;margin-top:7px}
.holder-result{
  font-size:10.5px;color:#9eaaaa;margin-top:4px;
  white-space:normal;
}

/* Bannerman-style stat cells, Tennis fonts */
.holder-stat{
  padding:18px 20px;border-right:1px solid var(--line);
  text-align:center;min-width:128px;
  display:flex;flex-direction:column;justify-content:center;
}
.holder-stat:last-child{
  border-right:0;
  background:rgba(31,95,70,.10);
  min-width:170px;
}
.holder-stat .n{
  font:600 27px/1 "Cormorant Garamond",Georgia,serif;
  color:var(--gold2);
}
.holder-stat .l{
  font-size:8px;text-transform:uppercase;letter-spacing:.10em;
  color:#819296;margin-top:7px;
}
.holder-stat .sub{
  font-size:9px;line-height:1.5;color:#8f9da0;margin-top:7px;
}
.holder-stat:last-child .n{color:var(--green-bright);font-size:22px}

.qa-note{
  margin-top:16px;font-size:9px;color:#65777a;
}

@media(max-width:900px){
  .holder-row{display:grid;grid-template-columns:1fr 1fr}
  .holder-main{
    grid-column:1/-1;border-right:0;border-bottom:1px solid var(--line)
  }
  .holder-stat:nth-of-type(2){border-bottom:1px solid var(--line)}
  .holder-stat:last-child{grid-column:1/-1}
}
@media(max-width:600px){
  .wrap{width:calc(100% - 26px)}
  .navlinks{display:none}
  .hero{padding-top:40px}
  .holder-row{display:block}
  .holder-main,.holder-stat{
    border-right:0;border-bottom:1px solid var(--line)
  }
  .holder-stat:last-child{border-bottom:0}
  .flag-shell{width:92px;flex-basis:92px}
}

/* Tennis at-a-glance, using Bannerman skeleton only */
.glance-wrap{padding:8px 0 34px}
.glance-panel{
  border:1px solid var(--line2);
  border-radius:14px;
  background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));
  overflow:hidden;
}
.glance-title{
  padding:15px 18px 11px;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.16em;
  color:var(--green-bright);
  font-weight:700;
  border-bottom:1px solid var(--line);
}
.glance-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
}
.glance-cell{
  padding:18px 18px 20px;
  border-right:1px solid var(--line);
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}
.glance-cell:last-child{border-right:0}
.glance-number{
  font:600 27px/1 "Cormorant Garamond",Georgia,serif;
  color:var(--gold2);
}
.glance-label{
  margin-top:8px;
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--cream);
}
.glance-sub{
  margin-top:7px;
  font-size:9px;
  color:#8f9da0;
  line-height:1.5;
}
@media(max-width:800px){
  .glance-grid{grid-template-columns:1fr 1fr}
  .glance-cell:nth-child(2){border-right:0}
  .glance-cell:nth-child(-n+2){border-bottom:1px solid var(--line)}
}
@media(max-width:520px){
  .glance-grid{grid-template-columns:1fr}
  .glance-cell{
    border-right:0!important;
    border-bottom:1px solid var(--line);
  }
  .glance-cell:last-child{border-bottom:0}
}


/* Last 6 title changes — John Edrich skeleton, Tennis design language */
.last6-wrap{padding:10px 0 42px}
.last6-head{margin-bottom:16px}
.last6-head h2{
  margin:0;
  font:600 32px/1 "Cormorant Garamond",Georgia,serif;
  color:var(--cream);
  letter-spacing:-.02em;
}
.tc-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}
.tc-card{
  background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));
  border:1px solid var(--line);
  border-radius:12px;
  padding:17px;
}
.tc-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin-bottom:15px;
}
.tc-date{
  font-size:9px;
  color:#8fa09e;
  letter-spacing:.04em;
}
.tc-stage{
  font-size:8px;
  font-weight:600;
  color:var(--gold2);
  background:rgba(196,154,71,.09);
  border:1px solid rgba(196,154,71,.18);
  padding:4px 8px;
  border-radius:999px;
  white-space:nowrap;
}
.tc-match{
  display:grid;
  grid-template-columns:1fr 26px 1fr;
  gap:10px;
  align-items:center;
}
.tc-player{
  display:flex;
  align-items:center;
  gap:7px;
  min-width:0;
}
.tc-flag{
  width:18px;
  height:13px;
  flex:0 0 auto;
  border-radius:2px;
  overflow:hidden;
  border:1px solid rgba(196,154,71,.24);
  background:#061119;
  display:grid;
  place-items:center;
}
.tc-flag.square{
  width:14px;
  height:14px;
}
.tc-flag img{
  width:100%;
  height:100%;
  display:block;
  object-fit:contain;
  object-position:center;
  background:#061119;
}
.tc-flag span{
  display:none;
  font-size:7px;
  font-weight:700;
  color:var(--cream);
  letter-spacing:.04em;
}
.tc-flag.is-fallback img{display:none}
.tc-flag.is-fallback span{display:block}
.tc-name{
  font:600 17px/1.08 Georgia,serif;
  color:var(--cream);
}
.tc-player.new .tc-name{color:var(--gold2)}
.tc-arrow{
  text-align:center;
  color:var(--green-bright);
  font-size:15px;
}
.tc-result{
  margin-top:14px;
  padding-top:12px;
  border-top:1px solid var(--line);
  text-align:center;
}
.tc-result b{
  display:block;
  font:600 13px/1.25 Georgia,serif;
  color:var(--cream);
}
.tc-result span{
  display:block;
  margin-top:4px;
  font-size:9px;
  color:#899a9b;
}
@media(max-width:900px){
  .tc-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  .tc-grid{grid-template-columns:1fr}
}


/* Historical timeline explorer */
.history-wrap{padding:8px 0 44px}
.history-head h2{margin:0 0 14px;font:600 32px/1 "Cormorant Garamond",Georgia,serif;color:var(--cream);letter-spacing:-.02em;}
.history-panel{border:1px solid var(--line2);border-radius:14px;background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));overflow:hidden;}
.history-top{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 20px;border-bottom:1px solid var(--line);flex-wrap:wrap;}
.history-title{font:600 28px/1 "Cormorant Garamond",Georgia,serif;color:var(--cream);}
.history-title span{color:var(--gold2)}
.history-control{display:flex;align-items:center;gap:10px;}
.history-control label{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:var(--green-bright);font-weight:700;}
.history-select{min-width:126px;padding:10px 12px;border-radius:8px;border:1px solid var(--line2);background:#08141c;color:var(--cream);font:500 13px Inter,sans-serif;}
.history-select:focus{outline:none;border-color:var(--gold)}
.history-summary{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line);}
.hy-cell{padding:18px 18px 16px;border-right:1px solid var(--line);text-align:center;}
.hy-cell:last-child{border-right:0}
.hy-big{font:600 26px/1 "Cormorant Garamond",Georgia,serif;color:var(--gold2);}
.hy-label{margin-top:8px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.10em;color:var(--cream);}
.hy-sub{margin-top:6px;font-size:10px;line-height:1.5;color:#8f9da0;}
.history-overview-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  border-bottom:1px solid var(--line);
}
.history-overview-cell{
  padding:16px 20px;
  border-right:1px solid var(--line);
}
.history-overview-cell:last-child{border-right:0}
.history-overview-label{
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.11em;
  color:var(--green-bright);
  font-weight:700;
  margin-bottom:6px;
}
.history-overview-value{
  font:600 18px/1.15 Georgia,serif;
  color:var(--cream);
}
.history-body{display:grid;grid-template-columns:1.1fr .9fr;gap:0;}
.history-left{padding:18px 20px 22px;border-right:1px solid var(--line);}
.history-right{padding:18px 20px 22px;}
.section-mini{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--green-bright);font-weight:700;margin-bottom:12px;}
.transfer-list{display:flex;flex-direction:column;gap:11px;max-height:620px;overflow:auto;padding-right:4px}
.transfer-item{border:1px solid var(--line);border-radius:10px;padding:12px 13px;background:rgba(255,255,255,.015);}
.transfer-date{font-size:10px;color:var(--gold2);margin-bottom:6px;}
.transfer-line{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px;}
.pair{display:inline-flex;align-items:center;gap:6px;min-width:0;}
.tflag{width:16px;height:12px;flex:0 0 auto;border-radius:2px;overflow:hidden;border:1px solid rgba(196,154,71,.24);background:#061119;display:grid;place-items:center;}
.tflag.square{width:12px;height:12px}
.tflag img{width:100%;height:100%;display:block;object-fit:contain;object-position:center;background:#061119}
.tflag span{display:none;font-size:6px;font-weight:700;color:var(--cream)}
.tflag.is-fallback img{display:none}.tflag.is-fallback span{display:block}
.pname{font:600 16px/1.05 Georgia,serif;color:var(--cream);}
.arrow{color:var(--green-bright);font-size:15px}
.transfer-meta{font-size:10px;color:#8f9da0;}
.insight-card{border:1px solid var(--line);border-radius:10px;padding:14px 14px 12px;background:rgba(255,255,255,.015);margin-bottom:12px;}
.insight-card b{display:block;font:600 18px/1.1 Georgia,serif;color:var(--cream);}
.insight-card span{display:block;margin-top:5px;font-size:10px;line-height:1.5;color:#8f9da0;}
.defence-list{display:flex;flex-direction:column;gap:8px;margin-top:2px}
.defence-row{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid var(--line)}
.defence-row:first-child{border-top:0}
.defence-name{display:inline-flex;align-items:center;gap:6px;min-width:0;}
.defence-count{font:600 17px/1 "Cormorant Garamond",Georgia,serif;color:var(--gold2);}
.history-empty{color:#8f9da0;font-size:11px;}
@media(max-width:920px){
  .history-summary{grid-template-columns:repeat(2,1fr)}
  .hy-cell:nth-child(2){border-right:0}
  .hy-cell:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .history-overview-row{grid-template-columns:1fr}
  .history-overview-cell{border-right:0;border-bottom:1px solid var(--line)}
  .history-overview-cell:last-child{border-bottom:0}
  .history-body{grid-template-columns:1fr}
  .history-left{border-right:0;border-bottom:1px solid var(--line)}
}
@media(max-width:600px){
  .history-top{align-items:flex-start}
  .history-title{font-size:24px}
  .history-summary{grid-template-columns:1fr}
  .hy-cell{border-right:0!important;border-bottom:1px solid var(--line)}
  .hy-cell:last-child{border-bottom:0}
}


/* Complete year rail: 1968–latest, fill height driven by yearly transfer count */
.year-rail-wrap{
  padding:14px 16px 16px;
  border-bottom:1px solid var(--line);
  background:#061119;
}
.year-rail{
  display:grid;
  grid-template-columns:repeat(12,1fr);
  gap:5px;
}
.year-box{
  position:relative;
  min-height:46px;
  border:1px solid #2f4444;
  background:#0a1a20;
  color:#c3ceca;
  border-radius:5px;
  cursor:pointer;
  overflow:hidden;
  font:600 9px/1 Inter,sans-serif;
  transition:border-color .15s,color .15s,transform .15s;
}
.year-box::before{
  content:"";
  position:absolute;
  left:0;right:0;bottom:0;
  height:var(--fill,5%);
  background:linear-gradient(180deg,rgba(62,139,104,.20),rgba(62,139,104,.52));
}
.year-box span{
  position:relative;
  z-index:1;
  display:grid;
  place-items:center;
  height:100%;
  min-height:44px;
}
.year-box:hover{
  border-color:var(--gold);
  color:var(--cream);
  transform:translateY(-1px);
}
.year-box.active{
  border-color:var(--gold2);
  color:var(--cream);
  box-shadow:0 0 0 1px rgba(213,171,85,.22);
}
.year-box.active::before{
  background:linear-gradient(180deg,rgba(196,154,71,.18),rgba(196,154,71,.48));
}
@media(max-width:1050px){.year-rail{grid-template-columns:repeat(10,1fr)}}
@media(max-width:850px){.year-rail{grid-template-columns:repeat(8,1fr)}}
@media(max-width:650px){.year-rail{grid-template-columns:repeat(5,1fr)}}


/* Leaderboard */
.leaderboard-wrap{padding:8px 0 48px}
.leaderboard-head h2{
  margin:0 0 16px;
  font:600 32px/1 "Cormorant Garamond",Georgia,serif;
  color:var(--cream);
  letter-spacing:-.02em;
}
.leader-tabs{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
  margin-bottom:14px;
}
.leader-tab{
  appearance:none;
  border:1px solid var(--line2);
  border-radius:9px;
  background:#081921;
  color:#aeb9b6;
  padding:12px 14px;
  cursor:pointer;
  text-align:center;
  font:600 13px/1.2 Inter,sans-serif;
  transition:.15s;
}
.leader-tab:hover{
  border-color:var(--gold);
  color:var(--cream);
}
.leader-tab.active{
  border-color:var(--gold2);
  background:rgba(196,154,71,.09);
  color:var(--cream);
  box-shadow:0 0 0 1px rgba(196,154,71,.12);
}
.leader-panel{
  border:1px solid var(--line2);
  border-radius:14px;
  background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));
  overflow:hidden;
}
.leader-table-head,
.leader-row{
  display:grid;
  grid-template-columns:52px 1fr 160px;
  gap:12px;
  align-items:center;
}
.leader-table-head{
  padding:12px 18px;
  border-bottom:1px solid var(--line);
  font-size:9px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.10em;
  color:var(--green-bright);
}
.leader-row{
  padding:12px 18px;
  border-top:1px solid var(--line);
}
.leader-row:first-child{border-top:0}
.leader-rank{
  font:600 18px/1 "Cormorant Garamond",Georgia,serif;
  color:#71858a;
}
.leader-name{
  font:600 17px/1.1 Georgia,serif;
  color:var(--cream);
}
.leader-value{
  text-align:right;
  font:600 22px/1 "Cormorant Garamond",Georgia,serif;
  color:var(--gold2);
}
.leader-value small{
  display:block;
  margin-top:4px;
  font:500 9px/1.3 Inter,sans-serif;
  color:#859698;
}
@media(max-width:760px){
  .leader-tabs{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
  .leader-tabs{grid-template-columns:1fr}
  .leader-table-head,.leader-row{grid-template-columns:38px 1fr 105px}
  .leader-name{font-size:15px}
}


/* Champion explorer */
.champ-wrap{padding:8px 0 52px}
.champ-head{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:16px}
.champ-kicker{font-size:9px;text-transform:uppercase;letter-spacing:.16em;color:var(--green-bright);font-weight:700}
.champ-head h2{margin:4px 0 0;font:600 32px/1 "Cormorant Garamond",Georgia,serif;color:var(--cream);letter-spacing:-.02em}
.champ-head p{margin:0;max-width:440px;text-align:right;font-size:11px;color:#8f9da0}
.champ-grid{display:grid;grid-template-columns:300px 1fr;gap:14px}
.champ-panel{border:1px solid var(--line2);border-radius:14px;background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));padding:16px}
.champ-search{padding-bottom:10px}
.champ-search input{width:100%;background:#071820;color:var(--cream);border:1px solid var(--line2);border-radius:7px;padding:10px 11px;font:500 12px Inter,sans-serif}
.champ-list{border-top:1px solid var(--line);max-height:500px;overflow-y:auto;scrollbar-gutter:stable}
.champ-item{display:flex;justify-content:space-between;gap:10px;padding:10px 4px;border-bottom:1px solid #142129;cursor:pointer}
.champ-item:hover,.champ-item.active{background:rgba(196,154,71,.06)}
.champ-item b{font:600 14px/1.15 Georgia,serif;color:var(--cream)}
.champ-item span{font-size:9px;color:#7f9294}
.champ-selected-top{display:flex;align-items:center;gap:9px}
.champ-selected-flag{width:22px;height:16px;border-radius:2px;overflow:hidden;border:1px solid rgba(196,154,71,.28);background:#061119;display:grid;place-items:center;flex:0 0 auto}
.champ-selected-flag.square{width:16px;height:16px}
.champ-selected-flag img{width:100%;height:100%;display:block;object-fit:contain;object-position:center;background:#061119}
.champ-selected-flag span{display:none;font-size:7px;font-weight:700;color:var(--cream)}
.champ-selected-flag.is-fallback img{display:none}.champ-selected-flag.is-fallback span{display:block}
.champ-name{font:600 31px/1 Georgia,serif;color:var(--cream)}
.champ-four{display:grid;grid-template-columns:repeat(4,1fr);margin:16px 0;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.champ-four div{padding:12px;border-left:1px solid var(--line);text-align:center}
.champ-four div:first-child{border-left:0}
.champ-four b{display:block;font:600 21px/1 "Cormorant Garamond",Georgia,serif;color:var(--gold2)}
.champ-four span{font-size:8px;color:#7f9294;text-transform:uppercase;letter-spacing:.08em}
.champ-detail-lower{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.champ-detail-col{border:1px solid var(--line);border-radius:9px;padding:12px 13px;background:rgba(255,255,255,.012)}
.champ-mini-title{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:var(--green-bright);font-weight:700;margin:0 0 8px}
.champ-mini{border-top:1px solid var(--line)}
.champ-mini-row{padding:9px 0;border-bottom:1px solid #142129}
.champ-mini-row b{font:600 13px/1.15 Georgia,serif;color:var(--cream)}
.champ-mini-row span{display:block;font-size:9px;color:#849698;margin-top:3px;line-height:1.45}
.champ-empty{font-size:10px;color:#849698;padding:10px 0}
@media(max-width:700px){.champ-detail-lower{grid-template-columns:1fr}}
@media(max-width:850px){
  .champ-grid{grid-template-columns:1fr}
  .champ-head{display:block}
  .champ-head p{text-align:left;margin-top:7px}
}
@media(max-width:600px){
  .champ-four{grid-template-columns:1fr 1fr}
}


#champion,#last6,#timeline,#leaderboard,#champions,#archive{
  scroll-margin-top:82px;
}


/* Full archive */
.archive-wrap{padding:8px 0 54px}
.archive-head{margin-bottom:16px}
.archive-kicker{
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.16em;
  color:var(--green-bright);
  font-weight:700;
}
.archive-head h2{
  margin:4px 0 0;
  font:600 32px/1 "Cormorant Garamond",Georgia,serif;
  color:var(--cream);
  letter-spacing:-.02em;
}
.archive-panel{
  border:1px solid var(--line2);
  border-radius:14px;
  background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));
  padding:16px;
}
.archive-controls{
  display:grid;
  grid-template-columns:1fr 165px 130px;
  gap:8px;
  margin-bottom:12px;
}
.archive-controls input,
.archive-controls select{
  width:100%;
  background:#071820;
  color:var(--cream);
  border:1px solid var(--line2);
  border-radius:7px;
  padding:10px 11px;
  font:500 11px Inter,sans-serif;
}
.archive-controls input:focus,
.archive-controls select:focus{outline:none;border-color:var(--gold)}
.archive-table-head,
.archive-row{
  display:grid;
  grid-template-columns:100px 82px 1fr 1.7fr;
  gap:12px;
  align-items:center;
}
.archive-table-head{
  padding:10px 6px;
  border-bottom:1px solid var(--line);
  font-size:8.5px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.09em;
  color:var(--green-bright);
}
.archive-row{
  padding:10px 6px;
  border-top:1px solid var(--line);
  font-size:10px;
  color:#9aa8a8;
}
.archive-row:first-child{border-top:0}
.archive-date{color:#8da09d}
.archive-type{
  font-size:8px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--gold2);
}
.archive-main{
  font:600 14px/1.1 Georgia,serif;
  color:var(--cream);
}
.archive-context{line-height:1.45}
.archive-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-top:12px;
  padding-top:12px;
  border-top:1px solid var(--line);
  font-size:9px;
  color:#7f9294;
}
.archive-footer button{
  border:1px solid var(--line2);
  background:#081921;
  color:#b9c2c0;
  border-radius:6px;
  padding:7px 10px;
  cursor:pointer;
}
.archive-footer button:disabled{opacity:.35;cursor:default}
.archive-footer button:not(:disabled):hover{border-color:var(--gold);color:var(--cream)}
@media(max-width:800px){
  .archive-controls{grid-template-columns:1fr}
  .archive-table-head,.archive-row{grid-template-columns:82px 66px 1fr}
  .archive-table-head>*:nth-child(4),.archive-row>*:nth-child(4){display:none}
}


.navlinks .nav-current{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  line-height:1.02;
  gap:1px;
}
#methodology{scroll-margin-top:82px}

/* Methodology */
.method-wrap{padding:10px 0 54px}
.method-head{margin-bottom:16px}
.method-kicker{
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.16em;
  color:var(--green-bright);
  font-weight:700;
}
.method-head h2{
  margin:4px 0 0;
  font:600 32px/1 "Cormorant Garamond",Georgia,serif;
  color:var(--cream);
  letter-spacing:-.02em;
}
.method-intro{
  max-width:850px;
  margin:10px 0 0;
  color:#98a7a5;
  font-size:11.5px;
  line-height:1.7;
}
.method-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}
.method-card{
  border:1px solid var(--line2);
  border-radius:12px;
  background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));
  padding:18px;
}
.method-card h3{
  margin:0 0 10px;
  font:600 20px/1.05 "Cormorant Garamond",Georgia,serif;
  color:var(--cream);
}
.method-card p{
  margin:0;
  color:#96a4a4;
  font-size:10.5px;
  line-height:1.7;
}
.method-card p + p{margin-top:9px}
.method-rule-list{
  display:grid;
  gap:0;
  border-top:1px solid var(--line);
  margin-top:12px;
}
.method-rule{
  display:grid;
  grid-template-columns:150px 1fr;
  gap:14px;
  padding:11px 0;
  border-bottom:1px solid var(--line);
}
.method-rule b{
  font:600 13px/1.25 Georgia,serif;
  color:var(--cream);
}
.method-rule span{
  font-size:10px;
  color:#8f9da0;
  line-height:1.6;
}
.method-source-note{
  margin-top:14px;
  border-left:3px solid var(--green2);
  padding:10px 0 10px 13px;
  color:#aeb9b6;
  font-size:10.5px;
  line-height:1.7;
}
@media(max-width:800px){
  .method-grid{grid-template-columns:1fr}
  .method-rule{grid-template-columns:1fr}
}

/* Footer — cricket skeleton, Tennis language */
footer{
  border-top:1px solid var(--line);
  margin-top:22px;
  padding:34px 0 44px;
}
.footer-grid{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:40px;
}
.footer-title{
  font-size:9px;
  letter-spacing:.13em;
  color:var(--green-bright);
  text-transform:uppercase;
  font-weight:700;
  margin-bottom:10px;
}
.footer-text{
  font-size:11px;
  color:#839395;
  line-height:1.75;
}
.footer-brand-title{
  font:600 18px/1.05 "Cormorant Garamond",Georgia,serif;
  color:var(--cream);
  margin-bottom:10px;
}
.footer-meta{
  font-size:10px;
  color:#718186;
  line-height:1.8;
}
.footer-meta .lineage-verified{
  color:#91a19e;
  margin-bottom:5px;
}
.footer-error-link{
  color:var(--green-bright);
  text-decoration:none;
  border-bottom:1px solid rgba(127,190,161,.35);
}
.footer-error-link:hover{
  color:var(--cream);
  border-bottom-color:var(--cream);
}
@media(max-width:850px){
  .footer-grid{grid-template-columns:1fr}
}


/* Context banner */
.data-banner-wrap{padding:0 0 40px}
.data-banner{
  border:1px solid var(--line2);
  border-left:3px solid var(--gold2);
  border-radius:10px;
  background:linear-gradient(180deg,rgba(196,154,71,.06),rgba(7,20,28,.96));
  padding:16px 18px;
}
.data-banner-kicker{
  font-size:8.5px;
  text-transform:uppercase;
  letter-spacing:.13em;
  color:var(--green-bright);
  font-weight:700;
  margin-bottom:6px;
}
.data-banner-title{
  font:600 20px/1.1 "Cormorant Garamond",Georgia,serif;
  color:var(--cream);
  margin-bottom:6px;
}
.data-banner-text{
  font-size:11.5px;
  line-height:1.72;
  color:#94a3a2;
  max-width:none;
  width:100%;
}
.data-banner-text b{color:var(--gold2);font-weight:600}


.hero-distinction{
  display:inline-flex;
  align-items:center;
  gap:7px;
  margin-top:10px;
  padding:7px 10px;
  border:1px solid var(--line2);
  border-radius:999px;
  background:rgba(31,95,70,.10);
  color:#a9b8b4;
  font-size:9.5px;
  line-height:1.35;
}
.hero-distinction b{
  color:var(--green-bright);
  font-weight:700;
}


/* Self-contained flag rendering: no external image requests. */
.flag-shell img,
.tc-flag img,
.tflag img,
.champ-selected-flag img{display:none !important;}

.flag-shell .flag-fallback,
.tc-flag span,
.tflag span,
.champ-selected-flag span{
  display:block !important;
  overflow:visible;
  white-space:nowrap;
  text-align:center;
  line-height:1;
}
.flag-shell .flag-fallback{font-size:40px;}
.tc-flag span{font-size:13px;}
.tflag span{font-size:11px;}
.champ-selected-flag span{font-size:17px;}
.champ-selected-flag.historic-code{
  width:auto;
  min-width:25px;
  height:16px;
  padding:0 4px;
  border:1px solid var(--line2);
  border-radius:3px;
  background:#081921;
}
.champ-selected-flag.historic-code span{
  font:700 8px/16px Inter,Arial,sans-serif;
  letter-spacing:.04em;
  color:var(--cream);
}

.tc-flag,.tflag,.champ-selected-flag{
  overflow:visible;
  border:0;
  background:transparent;
}
.tc-flag.square,.tflag.square,.champ-selected-flag.square{width:auto;height:auto;}


.country-note-wrap{padding:0 0 42px}
.country-note{
  border:1px solid var(--line);
  border-radius:10px;
  padding:14px 16px;
  background:rgba(255,255,255,.012);
}
.country-note-title{
  font-size:8.5px;
  text-transform:uppercase;
  letter-spacing:.13em;
  color:var(--green-bright);
  font-weight:700;
  margin-bottom:7px;
}
.country-note p{
  margin:0;
  color:#89999a;
  font-size:10px;
  line-height:1.7;
}
.country-note a{
  color:#b6c1be;
  border-bottom:1px solid rgba(182,193,190,.25);
}





.champ-selected-flag.yug-flag{
  position:relative;
  display:inline-block;
  width:1.55em;
  height:1.02em;
  border-radius:2px;
  overflow:hidden;
  border:1px solid rgba(0,0,0,.14);
  background:linear-gradient(to bottom,#1f4aa8 0 33.333%,#fff 33.333% 66.666%,#d62828 66.666% 100%);
  vertical-align:-.08em;
}
.champ-selected-flag.yug-flag .yug-star{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#d71920;
  font-size:.62em;
  line-height:1;
  text-shadow:0 0 1px #fff;
}

\n/* Surface performance extension */
.surface-wrap{padding:8px 0 48px}
.surface-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:16px}
.surface-kicker{font-size:9px;text-transform:uppercase;letter-spacing:.16em;color:var(--green-bright);font-weight:700}
.surface-head h2{margin:4px 0 0;font:600 32px/1 "Cormorant Garamond",Georgia,serif;color:var(--cream);letter-spacing:-.02em}
.surface-head p{margin:0;max-width:510px;text-align:right;font-size:11px;color:#8f9da0}
.surface-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px}
.surface-summary-card{border:1px solid var(--line2);border-radius:10px;background:#081921;padding:13px 14px}
.surface-summary-name{font:600 17px/1.1 Georgia,serif;color:var(--cream);margin-bottom:8px}
.surface-summary-meta{font-size:10px;color:var(--muted);line-height:1.5}
.surface-summary-meta b{color:var(--gold2);font-weight:700}
.surface-panel{border:1px solid var(--line2);border-radius:14px;background:linear-gradient(180deg,rgba(10,28,35,.96),rgba(7,20,28,.96));overflow:hidden}
.surface-controls{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.55fr);gap:16px;padding:16px 18px;border-bottom:1px solid var(--line)}
.surface-control-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.10em;color:var(--green-bright);margin-bottom:8px}
.surface-buttons{display:flex;gap:7px;flex-wrap:wrap}
.surface-btn{appearance:none;border:1px solid var(--line2);border-radius:8px;background:#071820;color:#aeb9b6;padding:9px 11px;cursor:pointer;font:600 11px/1.15 Inter,sans-serif;transition:.15s}
.surface-btn:hover{border-color:var(--gold);color:var(--cream)}
.surface-btn.active{border-color:var(--gold2);background:rgba(196,154,71,.09);color:var(--cream);box-shadow:0 0 0 1px rgba(196,154,71,.12)}
.surface-table-head,.surface-row{display:grid;grid-template-columns:52px 1fr 160px;gap:12px;align-items:center}
.surface-table-head{padding:12px 18px;border-bottom:1px solid var(--line);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.10em;color:var(--green-bright)}
.surface-row{padding:11px 18px;border-top:1px solid var(--line)}
.surface-row:first-child{border-top:0}
.surface-rank{font:600 18px/1 "Cormorant Garamond",Georgia,serif;color:#71858a}
.surface-player{font:600 17px/1.1 Georgia,serif;color:var(--cream)}
.surface-value{text-align:right;font:600 22px/1 "Cormorant Garamond",Georgia,serif;color:var(--gold2)}
.surface-value small{display:block;margin-top:4px;font:500 9px/1.3 Inter,sans-serif;color:#859698}
.surface-note{padding:10px 18px 14px;border-top:1px solid var(--line);font-size:10px;color:#7f9094}
@media(max-width:850px){.surface-head{display:block}.surface-head p{margin-top:8px;text-align:left}.surface-summary{grid-template-columns:1fr 1fr}.surface-controls{grid-template-columns:1fr}}
@media(max-width:520px){.surface-summary{grid-template-columns:1fr}.surface-table-head,.surface-row{grid-template-columns:38px 1fr 105px}.surface-player{font-size:15px}.surface-btn{flex:1 1 auto}}\n
/* Holder surface profile — intentionally scoped to Explore a Holder */
.champ-surface-profile{
  margin:18px 0 20px;
  padding:16px 0 2px;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}
.champ-surface-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:12px;
  margin-bottom:12px;
}
.champ-surface-title{
  font-size:11px;
  letter-spacing:.13em;
  text-transform:uppercase;
  font-weight:900;
  color:var(--muted);
}
.champ-surface-note{
  font-size:11px;
  color:var(--muted);
}
.champ-surface-rows{
  display:grid;
  gap:9px;
  padding-bottom:14px;
}
.champ-surface-row{
  display:grid;
  grid-template-columns:62px minmax(0,1fr) 126px;
  align-items:center;
  gap:10px;
}
.champ-surface-label{
  font-size:12px;
  font-weight:850;
}
.champ-surface-track{
  height:14px;
  border-radius:999px;
  overflow:hidden;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.025);
}
.champ-surface-fill{
  height:100%;
  border-radius:999px;
  min-width:0;
}
.champ-surface-fill.hard{background:#7686a1}
.champ-surface-fill.clay{background:#a86f4b}
.champ-surface-fill.grass{background:#718d68}
.champ-surface-fill.carpet{background:#8c6d95}
.champ-surface-value{
  text-align:right;
  font-size:11px;
  color:var(--muted);
  white-space:nowrap;
}
.champ-surface-value b{color:var(--text);font-size:12px}
.champ-surface-empty{
  color:var(--muted);
  font-size:12px;
  padding:2px 0 14px;
}
@media(max-width:640px){
  .champ-surface-head{align-items:flex-start;flex-direction:column}
  .champ-surface-row{grid-template-columns:52px minmax(0,1fr) 104px;gap:8px}
  .champ-surface-value{font-size:10px}
}


/* 2026-09-25 refinement pass */
.tc-stage{
  color:var(--green-bright);
  background:rgba(62,139,104,.10);
  border-color:rgba(62,139,104,.26);
}
.year-box{
  border-color:#355250;
  color:#dfe7e4;
  font:700 11px/1 Inter,sans-serif;
  letter-spacing:.01em;
}
.year-box span{
  color:#eef3f1;
  text-shadow:0 1px 0 rgba(0,0,0,.28);
}
.year-box::before{
  background:linear-gradient(180deg,rgba(176,132,60,.16),rgba(176,132,60,.42));
}
.year-box:hover{
  border-color:var(--green-bright);
  color:var(--cream);
  box-shadow:0 0 0 1px rgba(62,139,104,.16);
}
.year-box.active{
  border-color:var(--green-bright);
  color:var(--cream);
  box-shadow:0 0 0 1px rgba(62,139,104,.24), 0 10px 18px rgba(0,0,0,.18);
}
.year-box.active::before{
  background:linear-gradient(180deg,rgba(196,154,71,.24),rgba(196,154,71,.58));
}
@media(max-width:650px){
  .year-box{font-size:10px}
}


/* breadcrumb navigation */
.crumb a{
  color:inherit;
  text-decoration:none;
}
.crumb a:hover,
.crumb a:focus-visible{
  color:var(--green-bright);
  text-decoration:underline;
  text-underline-offset:3px;
}

</style>
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="logo">LSC</div>
    <div class="brand">
      <b>Lineal Sport Championship</b>
      <span>Tennis</span>
    </div>
    <div class="navlinks">
      <a class="nav-current" href="#champion"><span>Current</span><span>Holder</span></a>
      <a href="#timeline">Timeline</a>
      <a href="#leaderboard">Leaderboard</a>
      <a href="#champions">Past Holders</a>
      <a href="#archive">Archive</a>
      <a href="#methodology">Methodology</a>
    </div>
  </div>
</header>

<div class="wrap crumb"><a href="index.html">Lineal Sport Championship</a> / <a href="tennis.html">Tennis</a></div>

<main class="wrap hero" id="champion">
  <div class="kicker">Since 1968 · Open Era lineage</div>
  <h1><span>Men's</span> Lineal Tennis Championship</h1>
  <p>An unofficial match-by-match lineal championship history.</p>
<div class="holder-row">
    <div class="holder-main">
      <div class="flag-shell" id="holderFlag" aria-label="Italy flag">
        <img alt="Italy" id="holderFlagImg">
        <span class="flag-fallback" id="holderFlagFallback">🇮🇹</span>
      </div>

      <div class="holder-copy">
        <div class="labelrow">
          <div class="holder-label">Current Holder</div>
</div>

        <div class="holder-name">Jannik Sinner</div>
        <div class="holder-since">Won on 12 July 2026</div>
        <div class="holder-result">def. Alexander Zverev · Wimbledon F · 6–7(7), 7–6(2), 6–3, 6–4</div>
      </div>
    </div>

    <div class="holder-stat">
      <div class="n" id="daysHeld">—</div>
      <div class="l">Days held</div>
      <div class="sub">Since 12 Jul 2026</div>
    </div>

