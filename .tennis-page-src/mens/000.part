<section class="wrap method-wrap" id="methodology">
  <div class="method-head">
    <div class="method-kicker">How the lineage is built</div>
    <h2>Methodology</h2>
    <p class="method-intro">
      This page reconstructs an unofficial match-by-match men’s lineal tennis championship from the start of the Open Era. The championship does not follow tournament winners: it follows the holder. Every eligible official singles match played by the reigning holder can either extend the reign or transfer the title.
    </p>
  </div>

  <div class="method-grid">
    <div class="method-card">
      <h3>Scope</h3>
      <div class="method-rule-list">
        <div class="method-rule"><b>Starting point</b><span>Ken Rosewall, 27 April 1968, at Bournemouth. The lineage proceeds chronologically from there, match by match.</span></div>
        <div class="method-rule"><b>Eligible competition</b><span>Grand Slams; ATP main-tour events and historical equivalents; Olympics; Davis Cup; ATP Finals; recognised official top-level singles competition; and historical premier professional circuits or events.</span></div>
        <div class="method-rule"><b>Excluded</b><span>Qualifying; lower ITF / Challenger / Futures-level competition; doubles, mixed doubles and juniors; unofficial exhibitions; standalone touring or one-night professional matches unless part of a formal recognised competition or league; World Team Tennis; and Laver Cup.</span></div>
      </div>
    </div>

    <div class="method-card">
      <h3>What counts</h3>
      <div class="method-rule-list">
        <div class="method-rule"><b>Title transfer</b><span>The title changes whenever the reigning holder loses an eligible completed singles match. It does not wait for the tournament final.</span></div>
        <div class="method-rule"><b>Successful defence</b><span>An eligible match actually played and officially won by the holder counts as one successful defence.</span></div>
        <div class="method-rule"><b>Walkover</b><span>A walkover before play begins is not a title match. There is no transfer and no defence.</span></div>
        <div class="method-rule"><b>Retirement after play starts</b><span>The official winner decides the title. If the holder loses by retirement after play has begun, the championship transfers.</span></div>
      </div>
    </div>

    <div class="method-card">
      <h3>Chronology and dates</h3>
      <div class="method-rule-list">
        <div class="method-rule"><b>Match date</b><span>The actual match or completion date governs chronology. A tournament start date is never substituted for the match date.</span></div>
        <div class="method-rule"><b>Date precision</b><span>Where an exact individual match day cannot be established, the record is labelled as reconstructed or tournament-order-only rather than assigning an invented exact date.</span></div>
        <div class="method-rule"><b>Same-day transfers</b><span>Because the lineage is match by match, more than one transfer can occur on the same calendar day. Zero-day reigns are therefore possible and are retained in the record.</span></div>
        <div class="method-rule"><b>Ordering</b><span>When multiple title matches occur within an event, draw order, round chronology and dated match evidence are used to preserve the sequence of the lineage.</span></div>
      </div>
    </div>

    <div class="method-card">
      <h3>Special cases and audit</h3>
      <div class="method-rule-list">
        <div class="method-rule"><b>Retirement succession</b><span>If a reigning holder officially retires and never plays another eligible official singles match, the title passes the day after the retirement announcement to the most recent player who had beaten him in eligible official singles.</span></div>
        <div class="method-rule"><b>Dormancy</b><span>Injury, suspension, hiatus or simple inactivity does not strip the title.</span></div>
        <div class="method-rule"><b>Sources</b><span>Match-level source references and date-status notes are retained in the research dataset. Exact dates are preferred; reconstructed chronology is explicitly labelled rather than presented as exact.</span></div>
        <div class="method-rule"><b>Counting</b><span>Transfers and successful defences together make up played title matches. A succession caused by retirement is a lineage transfer but not a played match.</span></div>
      </div>
    </div>
  </div>
</section>
<script>

function iso2FlagEmoji(iso2){
  const s = String(iso2 || '').trim().toUpperCase();
  if(!/^[A-Z]{2}$/.test(s)) return '';
  return String.fromCodePoint(...[...s].map(ch => 127397 + ch.charCodeAt(0)));
}

/*
  One self-contained flag renderer for every mapped holder.
  Supply ISO 3166-1 alpha-2 + display country + optional 3-letter fallback.
  No CSS changes per country.
*/
function setChampionFlag({iso2, country, fallback}) {
  const shell = document.getElementById('holderFlag');
  const fb = document.getElementById('holderFlagFallback');
  shell.setAttribute('aria-label', country + ' flag');
  const emoji = iso2FlagEmoji(iso2);
  fb.textContent = emoji || fallback || country || '';
  shell.classList.add('is-fallback');
}

setChampionFlag({
  iso2: 'it',
  country: 'Italy',
  fallback: 'ITA'
});

// Dynamic days held: presentation value only.
(function(){
  const acquired = Date.UTC(2026,6,12);
  const now = new Date();
  const todayUTC = Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate());
  document.getElementById('daysHeld').textContent =
    Math.max(0, Math.floor((todayUTC-acquired)/86400000)).toLocaleString();
})();



const esc = value => String(value ?? '')
  .replaceAll('&','&amp;')
  .replaceAll('<','&lt;')
  .replaceAll('>','&gt;')
  .replaceAll('"','&quot;')
  .replaceAll("'","&#039;");

const fmt = dateString => {
  if(!dateString) return 'Date unresolved';
  const parts = String(dateString).split('-').map(Number);
  if(parts.length !== 3 || parts.some(Number.isNaN)) return String(dateString);
  const d = new Date(Date.UTC(parts[0], parts[1]-1, parts[2]));
  return new Intl.DateTimeFormat('en-GB',{
    day:'numeric',
    month:'short',
    year:'numeric',
    timeZone:'UTC'
  }).format(d);
};

