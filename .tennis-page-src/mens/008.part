const CHAMPION_COUNTRY_MAP = Object.fromEntries(Object.entries(HOLDER_COUNTRY_AUDIT).filter(([_,v])=>v.iso2).map(([k,v])=>[k,v.iso2]));

function champFlagHTML(name){
  const live = (window.LSC_LIVE_PLAYER_MAP || {})[name];
  if(live?.flag){
    return `<span class="champ-selected-flag" aria-label="${esc(live.country || name)} representation"><span>${esc(live.flag)}</span></span>`;
  }
  const meta = HOLDER_COUNTRY_AUDIT[name];
  if(!meta) return '';
  if(meta.ioc === 'YUG'){
    return `<span class="champ-selected-flag yug-flag" aria-label="Yugoslavia representation"><span class="yug-star">★</span></span>`;
  }
  const emoji = iso2FlagEmoji(meta.iso2);
  return emoji ? `<span class="champ-selected-flag" aria-label="${esc(meta.country || meta.ioc)} representation"><span>${emoji}</span></span>` : '';
}
function initChampionFlag(scope){
  return;
}

function pluralizeCount(n, singular, plural){
  n = Number(n || 0);
  return n.toLocaleString() + ' ' + (n === 1 ? singular : (plural || singular + 's'));
}
function championDefenceRows(name){
  const rows = CHAMPION_DEFENCES[name] || [];
  if(!rows.length) return '<div class="champ-empty">No successful defence detail available.</div>';
  return rows.map(d=>{
    const opp = d.opponent || d.loser || d.defeated || d.challenger || 'Opponent';
    const event = d.event || d.tournament || '—';
    const round = d.round || '';
    const score = d.score || '';
    const when = d.date ? fmt(d.date) : (d.year ? String(d.year) : 'Date not materialised');
    return `<div class="champ-mini-row">
      <b>${when} · ${esc(event)}${round ? ' · ' + esc(round) : ''}</b>
      <span>def. ${esc(opp)}${score ? ' · ' + esc(score) : ''}</span>
    </div>`;
  }).join('');
}
function championRecentRows(p){
  const rs = p.recent_reigns || [];
  if(!rs.length) return '<div class="champ-empty">No reign detail available.</div>';
  return rs.map(r=>{
    const end = r.end ? fmt(r.end) : 'Current';
    const context = r.ended_by ? ('Ended by ' + esc(r.ended_by)) : 'Current reign';
    return `<div class="champ-mini-row">
      <b>${fmt(r.start)} – ${end}</b>
      <span>${pluralizeCount(r.days || 0,'day')} · ${context}</span>
    </div>`;
  }).join('');
}

