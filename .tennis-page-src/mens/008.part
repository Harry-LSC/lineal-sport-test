function championSurfaceProfile(player){
  const d = HOLDER_SURFACE_DATA[player];
  if(!d) return '<div class="champ-surface-empty">No audited surface profile available.</div>';
  const surfaces = ['Hard','Clay','Grass','Carpet'];
  const maxTotal = Math.max(1, ...surfaces.map(s => Number(d[s]?.total || 0)));
  const slug = s => s.toLowerCase();
  const rows = surfaces.map(s=>{
    const x=d[s] || {total:0,transfers:0,defences:0};
    const pct = (Number(x.total||0) / maxTotal) * 100;
    const tooltip = `${s}: ${x.total} lineal title matches won · ${x.transfers} title changes · ${x.defences} successful defences`;
    return `<div class="champ-surface-row" title="${esc(tooltip)}">
      <div class="champ-surface-label">${s}</div>
      <div class="champ-surface-track"><div class="champ-surface-fill ${slug(s)}" style="width:${pct.toFixed(2)}%"></div></div>
      <div class="champ-surface-value"><b>${Number(x.total).toLocaleString()}</b> · ${x.transfers} + ${x.defences}</div>
    </div>`;
  }).join('');
  return `<div class="champ-surface-profile">
    <div class="champ-surface-head">
      <div class="champ-surface-title">By surface</div>
      <div class="champ-surface-note">title changes + successful defences</div>
    </div>
    <div class="champ-surface-rows">${rows}</div>
  </div>`;
}

function renderChampion(name){
  const p = CHAMPION_DATA.find(x=>x.player===name) || CHAMPION_DATA[0];
  const detail = document.querySelector('#champDetail');
  detail.innerHTML = `
    <div class="champ-selected-top">
      ${champFlagHTML(p.player)}
      <div class="champ-name">${esc(p.player)}</div>
    </div>
    <div class="champ-four">
      <div><b>${Number(p.days).toLocaleString()}</b><span>Days in reign</span></div>
      <div><b>${Number(p.reigns).toLocaleString()}</b><span>Reigns</span></div>
      <div><b>${Number(p.defences).toLocaleString()}</b><span>Defences</span></div>
      <div><b>${Number(p.longest).toLocaleString()}</b><span>Longest reign</span></div>
    </div>
    ${championSurfaceProfile(p.player)}
    <div class="champ-detail-lower">
      <div class="champ-detail-col">
        <div class="champ-mini-title">Recent reigns</div>
        <div class="champ-mini">${championRecentRows(p)}</div>
      </div>
      <div class="champ-detail-col">
        <div class="champ-mini-title">Latest successful defences</div>
        <div class="champ-mini">${championDefenceRows(p.player)}</div>
      </div>
    </div>
  `;
  initChampionFlag(detail);
  document.querySelectorAll('.champ-item').forEach(el=>el.classList.toggle('active', el.dataset.player===p.player));
}
function renderChampionList(query=''){
  const q = query.trim().toLowerCase();
  const rows = CHAMPION_DATA
    .filter(p=>!q || p.player.toLowerCase().includes(q))
    .sort((a,b)=>a.player.localeCompare(b.player));
  document.querySelector('#champList').innerHTML = rows.map(p=>`
    <div class="champ-item" data-player="${esc(p.player)}">
      <b>${esc(p.player)}</b>
      <span>${pluralizeCount(p.reigns,'reign')}</span>
    </div>
  `).join('');
  document.querySelectorAll('.champ-item').forEach(el=>{
    el.addEventListener('click', ()=>renderChampion(el.dataset.player));
  });
}
function initChampionExplorer(){
  renderChampionList('');
  const first = CHAMPION_DATA.find(p=>p.player==='Jannik Sinner') || CHAMPION_DATA[0];
  renderChampion(first.player);
  document.querySelector('#champSearch').addEventListener('input', e=>renderChampionList(e.target.value));
}


