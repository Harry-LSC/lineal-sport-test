const HISTORY_YEARS = Object.keys(HISTORY_YEAR_DATA).map(Number).sort((a,b)=>a-b);

function makeFlagHTML(name){
  return `<span class="pair"><span class="pname">${esc(name)}</span></span>`;
}
function initHistoryFlags(scope){
  (scope || document).querySelectorAll('.tflag').forEach(shell=>{
    const img=shell.querySelector('img');
    const iso=shell.getAttribute('data-flag');
    img.onerror=()=>{ shell.style.display='none'; };
    img.onload=()=>shell.classList.remove('is-fallback');
    img.src='';
  });
}
function renderHistoryYear(y){
  const d = HISTORY_YEAR_DATA[String(y)];
  if(!d) return;
  document.querySelectorAll('.year-box').forEach(btn=>{
    btn.classList.toggle('active', Number(btn.dataset.year) === Number(y));
  });
  const sel = document.querySelector('#historyYearSelect');
  if(sel && Number(sel.value) !== Number(y)) sel.value = String(y);
  document.querySelector('#hyYear').textContent = y;
  document.querySelector('#hyTransfers').textContent = (d.transfers || 0).toLocaleString();
  document.querySelector('#hyDefences').textContent = (d.defences || 0).toLocaleString();
  document.querySelector('#hyMatches').textContent = (d.title_matches || 0).toLocaleString();
  document.querySelector('#historyListTitle').textContent = 'Transfers in ' + y;
  document.querySelector('#hyEntryChampion').textContent = d.entry || '—';
  document.querySelector('#hyExitChampion').textContent = d.exit || '—';
  const busy = d.busiest_event || null;
  document.querySelector('#hyBusyEvent').textContent = busy && busy.event ? busy.event : 'No transfer event recorded';
  document.querySelector('#hyBusyEventSub').textContent = busy && busy.event ? (busy.transfers + ' title change' + (busy.transfers===1?'':'s') + ' in the busiest event of ' + y + '.') : ('No event-level transfer note stored for ' + y + '.');

  const rows = d.transfers_rows || [];
  document.querySelector('#historyTransfers').innerHTML = rows.length ? rows.map(r=>`
      <div class="transfer-item">
        <div class="transfer-date">${fmt(r.date)}</div>
        <div class="transfer-line">
          ${makeFlagHTML(r.from)} <span class="arrow">→</span> ${makeFlagHTML(r.to)}
        </div>
        <div class="transfer-meta">${esc(r.event || '—')} · ${esc(r.round || '—')}${r.score ? ' · ' + esc(r.score) : ''}</div>
      </div>
  `).join('') : '<div class="history-empty">No title changes recorded for this year.</div>';

  const leaders = d.defence_leaders || [];
  document.querySelector('#historyLeaders').innerHTML = leaders.length ? leaders.map(r=>`
      <div class="defence-row">
        <div class="defence-name">${makeFlagHTML(r.player)}</div>
        <div class="defence-count">${r.count}</div>
      </div>
  `).join('') : '<div class="history-empty">No successful defences recorded for this year.</div>';

  initHistoryFlags(document.querySelector('.history-panel'));
}
function initHistoryExplorer(){
  const firstYear = HISTORY_YEARS[0];
  const lastYear = HISTORY_YEARS[HISTORY_YEARS.length-1];
  document.querySelector('#historyRangeLabel').textContent = '· ' + firstYear + '–' + lastYear;

  const sel = document.querySelector('#historyYearSelect');
  sel.innerHTML = HISTORY_YEARS.slice().reverse().map(y=>`<option value="${y}">${y}</option>`).join('');
  sel.value = String(lastYear);
  sel.addEventListener('change', e=>renderHistoryYear(+e.target.value));

  const maxTransfers = Math.max(...HISTORY_YEARS.map(y => Number(HISTORY_YEAR_DATA[String(y)].transfers || 0)));
  const rail = document.querySelector('#historyYearRail');
  rail.innerHTML = HISTORY_YEARS.map(y=>{
    const n = Number(HISTORY_YEAR_DATA[String(y)].transfers || 0);
    const fill = maxTransfers ? Math.max(6, Math.round((n / maxTransfers) * 100)) : 6;
    return `<button class="year-box" type="button" data-year="${y}" style="--fill:${fill}%" title="${y}: ${n} title change${n===1?'':'s'}"><span>${y}</span></button>`;
  }).join('');

  rail.querySelectorAll('.year-box').forEach(btn=>{
    btn.addEventListener('click', ()=>renderHistoryYear(+btn.dataset.year));
  });

  renderHistoryYear(lastYear);
}


const LEADERBOARD_DATA = {"days": [{"player": "Serena Williams", "value": 2505}, {"player": "Martina Navratilova", "value": 2051}, {"player": "Steffi Graf", "value": 1905}, {"player": "Chris Evert", "value": 1796}, {"player": "Billie Jean King", "value": 1119}, {"player": "Monica Seles", "value": 719}, {"player": "Venus Williams", "value": 707}, {"player": "Justine Henin", "value": 487}, {"player": "Aryna Sabalenka", "value": 479}, {"player": "Margaret Court", "value": 433}, {"player": "Martina Hingis", "value": 417}, {"player": "Lindsay Davenport", "value": 413}], "defences": [{"player": "Martina Navratilova", "value": 436}, {"player": "Steffi Graf", "value": 347}, {"player": "Chris Evert", "value": 338}, {"player": "Serena Williams", "value": 225}, {"player": "Billie Jean King", "value": 144}, {"player": "Margaret Court", "value": 122}, {"player": "Monica Seles", "value": 114}, {"player": "Venus Williams", "value": 107}, {"player": "Justine Henin", "value": 95}, {"player": "Lindsay Davenport", "value": 82}, {"player": "Martina Hingis", "value": 71}, {"player": "Iga Świątek", "value": 66}], "reigns": [{"player": "Chris Evert", "value": 43}, {"player": "Martina Navratilova", "value": 40}, {"player": "Serena Williams", "value": 39}, {"player": "Billie Jean King", "value": 28}, {"player": "Steffi Graf", "value": 26}, {"player": "Venus Williams", "value": 24}, {"player": "Lindsay Davenport", "value": 23}, {"player": "Aryna Sabalenka", "value": 20}, {"player": "Monica Seles", "value": 18}, {"player": "Justine Henin", "value": 17}, {"player": "Maria Sharapova", "value": 16}, {"player": "Martina Hingis", "value": 15}], "longest": [{"player": "Billie Jean King", "value": 464, "start": "1975-07-02", "end": "1976-10-08"}, {"player": "Serena Williams", "value": 411, "start": "2017-01-26", "end": "2018-03-13"}, {"player": "Serena Williams", "value": 347, "start": "2010-07-03", "end": "2011-06-15"}, {"player": "Steffi Graf", "value": 320, "start": "1989-07-04", "end": "1990-05-20"}, {"player": "Serena Williams", "value": 279, "start": "2003-07-05", "end": "2004-04-09"}, {"player": "Martina Navratilova", "value": 278, "start": "1984-03-03", "end": "1984-12-06"}, {"player": "Naomi Osaka", "value": 215, "start": "2020-08-28", "end": "2021-03-31"}, {"player": "Martina Navratilova", "value": 203, "start": "1986-07-05", "end": "1987-01-24"}, {"player": "Martina Navratilova", "value": 197, "start": "1983-07-02", "end": "1984-01-15"}, {"player": "Serena Williams", "value": 195, "start": "2014-10-25", "end": "2015-05-08"}, {"player": "Venus Williams", "value": 170, "start": "2001-08-05", "end": "2002-01-22"}, {"player": "Steffi Graf", "value": 168, "start": "1988-06-04", "end": "1988-11-19"}]};
const LEADERBOARD_META = {
  days:{head:'Days', suffix:'days'},
  defences:{head:'Defences', suffix:'defences'},
  reigns:{head:'Reigns', suffix:'reigns'},
  longest:{head:'Days', suffix:'days'}
};

function renderLeaderboard(metric){
  const meta = LEADERBOARD_META[metric];
  const rows = LEADERBOARD_DATA[metric] || [];
  document.querySelector('#leaderMetricHead').textContent = meta.head;
  document.querySelector('#leaderRows').innerHTML = rows.map((r,i)=>{
    const extra = metric === 'longest' && r.start && r.end
      ? `<small>${fmt(r.start)} – ${fmt(r.end)}</small>`
      : '';
    return `<div class="leader-row">
      <div class="leader-rank">${i+1}</div>
      <div class="leader-name">${esc(r.player)}</div>
      <div class="leader-value">${Number(r.value).toLocaleString()}${extra}</div>
    </div>`;
  }).join('');

  document.querySelectorAll('.leader-tab').forEach(btn=>{
    btn.classList.toggle('active', btn.dataset.metric === metric);
  });
}

function initLeaderboard(){
  document.querySelectorAll('.leader-tab').forEach(btn=>{
    btn.addEventListener('click', ()=>renderLeaderboard(btn.dataset.metric));
  });
  renderLeaderboard('days');
}


