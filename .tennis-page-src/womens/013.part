-R1075","WT-R1076"];
function archiveRecords(){
  const byReign = new Map();
  FULL_ARCHIVE_DATA.defences.forEach(d=>{
    const id = String(d.reign_id || '');
    if (!byReign.has(id)) byReign.set(id,[]);
    byReign.get(id).push(d);
  });

  const all = [];
  let order = 0;
  ARCHIVE_REIGN_SEQUENCE.forEach((reignId,index)=>{
    const defs = (byReign.get(reignId) || []).slice()
      .sort((a,b)=>(Number(a.number)||0)-(Number(b.number)||0));
    defs.forEach(d=>{
      all.push({
        date:d.date,
        year:d.year,
        type:'defence',
        main:d.holder,
        other:d.opponent,
        event:d.event,
        round:d.round,
        score:d.score,
        _order:++order
      });
    });

    if (index < FULL_ARCHIVE_DATA.transfers.length){
      const t = FULL_ARCHIVE_DATA.transfers[index];
      all.push({
        date:t.date,
        year:t.year,
        type:'transfer',
        main:t.to,
        other:t.from,
        event:t.event,
        round:t.round,
        score:t.score,
        _order:++order
      });
    }
  });
  return all;
}
const ARCHIVE_ALL = archiveRecords();

function renderArchive(){
  const start = archivePage * ARCHIVE_PAGE_SIZE;
  const rows = archiveFiltered.slice(start,start+ARCHIVE_PAGE_SIZE);
  document.querySelector('#archiveRows').innerHTML = rows.map(r=>`
    <div class="archive-row">
      <div class="archive-date">${r.date ? fmt(r.date) : r.year}</div>
      <div class="archive-type">${esc(r.type)}</div>
      <div class="archive-main">${esc(r.main)}</div>
      <div class="archive-context">${esc(r.other)} · ${esc(r.event || '—')}${r.round ? ' · ' + esc(r.round) : ''}${r.score ? ' · ' + esc(r.score) : ''}</div>
    </div>
  `).join('');

  const pages = Math.max(1,Math.ceil(archiveFiltered.length / ARCHIVE_PAGE_SIZE));
  document.querySelector('#archiveCount').textContent =
    archiveFiltered.length.toLocaleString() + ' records · page ' + (archivePage+1) + ' of ' + pages;
  document.querySelector('#archivePrev').disabled = archivePage === 0;
  document.querySelector('#archiveNext').disabled = archivePage >= pages-1;
}

function filterArchive(){
  const q = document.querySelector('#archiveSearch').value.trim().toLowerCase();
  const typ = document.querySelector('#archiveType').value;
  const yr = document.querySelector('#archiveYear').value;

  archiveFiltered = ARCHIVE_ALL.filter(r=>{
    const typeOk = typ === 'all' || r.type === typ;
    const yearOk = yr === 'all' || String(r.year) === String(yr);
    const qOk = !q || [r.main,r.other,r.event,r.round,r.score]
      .some(v=>String(v || '').toLowerCase().includes(q));
    return typeOk && yearOk && qOk;
  }).sort((a,b)=>(Number(b._order)||0)-(Number(a._order)||0));

  archivePage = 0;
  renderArchive();
}

function initArchive(){
  const years = [...new Set(ARCHIVE_ALL.map(r=>Number(r.year)).filter(Boolean))].sort((a,b)=>b-a);
  const yearSelect = document.querySelector('#archiveYear');
  years.forEach(y=>yearSelect.insertAdjacentHTML('beforeend',`<option value="${y}">${y}</option>`));

  document.querySelector('#archiveSearch').addEventListener('input',filterArchive);
  document.querySelector('#archiveType').addEventListener('change',filterArchive);
  document.querySelector('#archiveYear').addEventListener('change',filterArchive);
  document.querySelector('#archivePrev').addEventListener('click',()=>{
    if(archivePage>0){archivePage--;renderArchive();}
  });
  document.querySelector('#archiveNext').addEventListener('click',()=>{
    const pages=Math.max(1,Math.ceil(archiveFiltered.length/ARCHIVE_PAGE_SIZE));
    if(archivePage<pages-1){archivePage++;renderArchive();}
  });

  filterArchive();
}

document.querySelectorAll('.tc-flag').forEach(function(shell){
  var iso = shell.getAttribute('data-flag');
  var span = shell.querySelector('span');
  var emoji = iso2FlagEmoji(iso);
  if(span) span.textContent = emoji || shell.getAttribute('data-code') || '';
  shell.classList.add('is-fallback');
});
initHistoryExplorer();
initLeaderboard();
initChampionExplorer();
initArchive();

</script>


<section class="wrap country-note-wrap">
  <div class="country-note">
    <div class="country-note-title">Country / tennis representation</div>
    <p>
      Holder flags are identification metadata rather than a claim about legal nationality at the date of every match.
      The 270-holder lookup is based primarily on the Jeff Sackmann archive; later gaps were cross-checked against official WTA player profiles.
      The Sackmann country field is canonical player metadata and should not be read as a match-date nationality history.
      Where an official WTA profile records a later representation change, the holder-level display uses that latest verified representation.
      Historical state codes are retained rather than silently reassigned to modern countries; where no modern Unicode flag exists, the historical code itself is shown.
      <a href="https://github.com/Aneeshers/tennis-sackmann-archive" target="_blank" rel="noopener noreferrer">Sackmann archive mirror</a>
      ·
      <a href="https://www.wtatennis.com/players" target="_blank" rel="noopener noreferrer">WTA player profiles</a>.
    </p>
  </div>
</section>
</div>

<footer>
  <div class="wrap footer-grid">
    <div>
      <div class="footer-title">About the Women’s Lineal Tennis Championship</div>
      <div class="footer-text">
        An unofficial match-by-match championship history of women’s singles lineal tennis. This is an independent fan project and is not an official WTA, ITF or Grand Slam championship.
      </div>
    </div>

    <div>
      <div class="footer-brand-title">Lineal Sport Championship</div>
      <div class="footer-meta">
        <div class="lineage-verified">Current women’s lineage state verified through 12 September 2026.</div>
        <div>© <span class="lsc-current-year">2026</span> Lineal Sport Championship</div>
        <div>An independent fan project. Not affiliated with any governing body, tour, tournament or player.</div>
        <div><a class="footer-error-link" href="mailto:linealsportchamp@gmail.com?subject=Lineal%20Sport%20Championship%20Tennis%20correction">Found an error? Let us know.</a></div>
      </div>
    </div>
  </div>
</footer>
<script>
document.querySelectorAll('.lsc-current-year').forEach(function(el){
  el.textContent = new Date().getFullYear();
});

const SURFACE_LEADER_DATA = {"transfers":{"All":[{"player":"Chris Evert","value":43},{"player":"Martina Navratilova","value":40},{"player":"Serena Williams","value":39},{"player":"Billie Jean King","value":28},{"player":"Steffi Graf","value":26},{"player":"Venus Williams","value":24},{"player":"Lindsay Davenport","value":23},{"player":"Aryna Sabalenka","value":20},{"player":"Monica Seles","value":18},{"player":"Justine Henin","value":17}],"Hard":[{"player":"Serena Williams","value":25},{"player":"Aryna Sabalenka","value":14},{"player":"Lindsay Davenport","value":14},{"player":"Chris Evert","value":13},{"player":"Venus Williams","value":13},{"player":"Martina Hingis","value":10},{"player":"Jessica Pegula","value":9},{"player":"Maria Sharapova","value":9},{"player":"Monica Seles","value":9},{"player":"Steffi Graf","value":9}],"Clay":[{"player":"Chris Evert","value":13},{"player":"Arantxa Sánchez Vicario","value":9},{"player":"Justine Henin","value":9},{"player":"Steffi Graf","value":9},{"player":"Conchita Martínez","value":8},{"player":"Serena Williams","value":6},{"player":"Aryna Sabalenka","value":5},{"player":"Billie Jean King","value":5},{"player":"Gabriela Sabatini","value":5},{"player":"Margaret Court","value":5}],"Grass":[{"player":"Martina Navratilova","value":11},{"player":"Billie Jean King","value":10},{"player":"Chris Evert","value":8},{"player":"Venus Williams","value":8},{"player":"Serena Williams","value":7},{"player":"Evonne Goolagong","value":5},{"player":"Kerry Reid","value":4},{"player":"Sabine Lisicki","value":4},{"player":"Angelique Kerber","value":3},{"player":"Hana Mandlíková","value":3}],"Carpet":[{"player":"Martina Navratilova","value":20},{"player":"Chris Evert","value":8},{"player":"Billie Jean King","value":7},{"player":"Steffi Graf","value":6},{"player":"Virginia Wade","value":6},{"player":"Evonne Goolagong","value":5},{"player":"Rosie Casals","value":5},{"player":"Tracy Austin","value":5},{"player":"Gabriela Sabatini","value":4},{"player":"Lindsay Davenport","value":4}]},"defences":{"All":[{"player":"Martina Navratilova","value":436},{"player":"Steffi Graf","value":347},{"player":"Chris Evert","value":338},{"player":"Serena Williams","value":225},{"player":"Billie Jean King","value":144},{"player":"Margaret Court","value":122},{"player":"Monica Seles","value":114},{"player":"Venus Williams","value":107},{"player":"Justine Henin","value":95},{"player":"Lindsay Davenport","value":82}],"Hard":[{"player":"Serena Williams","value":140},{"player":"Steffi Graf","value":128},{"player":"Martina Navratilova","value":90},{"player":"Chris Evert","value":84},{"player":"Venus Williams","value":73},{"player":"Monica Seles","value":69},{"player":"Lindsay Davenport","value":56},{"player":"Aryna Sabalenka","value":44},{"player":"Justine Henin","value":37},{"player":"Maria Sharapova","value":37}],"Clay":[{"player":"Steffi Graf","value":119},{"player":"Chris Evert","value":96},{"player":"Martina Navratilova","value":61},{"player":"Serena Williams","value":55},{"player":"Margaret Court","value":43},{"player":"Billie Jean King","value":35},{"player":"Iga Świątek","value":35},{"player":"Justine Henin","value":33},{"player":"Venus Williams","value":25},{"player":"Conchita Martínez","value":22}],"Grass":[{"player":"Martina Navratilova","value":77},{"player":"Chris Evert","value":68},{"player":"Steffi Graf","value":42},{"player":"Margaret Court","value":38},{"player":"Serena Williams","value":26},{"player":"Billie Jean King","value":25},{"player":"Justine Henin","value":23},{"player":"Ann Jones","value":16},{"player":"Evonne Goolagong","value":13},{"player":"Jana Novotná","value":13}],"Carpet":[{"player":"Martina Navratilova","value":208},{"player":"Chris Evert","value":90},{"player":"Steffi Graf","value":58},{"player":"Billie Jean King","value":48},{"player":"Margaret Court","value":29},{"player":"Monica Seles","value":23},{"player":"Lindsay Davenport","value":20},{"player":"Martina Hingis","value":15},{"player":"Tracy Austin","value":11},{"player":"Evonne Goolagong","value":10}]}};
(function initSurfacePerformance(){
  const rowsEl=document.getElementById('surfaceRows');
  if(!rowsEl) return;
  let metric='defences';
  let court='All';
  const metricLabel={transfers:'Title changes',defences:'Successful defences'};
  const unitLabel={transfers:'title changes',defences:'defences'};
  function draw(){
    const rows=(SURFACE_LEADER_DATA[metric] && SURFACE_LEADER_DATA[metric][court]) || [];
    document.getElementById('surfaceValueHead').textContent=metricLabel[metric];
    rowsEl.innerHTML=rows.map((r,i)=>`<div class="surface-row"><div class="surface-rank">${i+1}</div><div class="surface-player">${esc(r.player)}</div><div class="surface-value">${Number(r.value).toLocaleString()}<small>${court==='All'?'all surfaces':court} · ${unitLabel[metric]}</small></div></div>`).join('');
    document.querySelectorAll('[data-surface-metric]').forEach(b=>b.classList.toggle('active',b.dataset.surfaceMetric===metric));
    document.querySelectorAll('[data-surface-court]').forEach(b=>b.classList.toggle('active',b.dataset.surfaceCourt===court));
  }
  document.querySelectorAll('[data-surface-metric]').forEach(b=>b.addEventListener('click',()=>{metric=b.dataset.surfaceMetric;draw();}));
  document.querySelectorAll('[data-surface-court]').forEach(b=>b.addEventListener('click',()=>{court=b.dataset.surfaceCourt;draw();}));
  draw();
})();
</script>
<script>
/* LSC tennis workbook-driven live update overlay */
(async() => {
  const LINEAGE = "Women's Singles";
  let PIPELINE;
  try {
    const response = await fetch('data/tennis-data.json', {cache:'no-store'});
    if (!response.ok) throw new Error('HTTP ' + response.status);
    PIPELINE = await response.json();
  } catch (error) {
    console.error('LSC tennis data load failed', error);
    return;
  }

  const state = PIPELINE.lineages.find(x => x.lineage === LINEAGE);
  const updates = PIPELINE.lineage_updates.filter(x => x.lineage === LINEAGE);
  if (!state) return;

  // Populate Full Archive immediately, before any other test-only UI updates.
  // This is deliberately early so a later rendering error cannot suppress archive rows.
  try {
    if (typeof ARCHIVE_ALL !== 'undefined' && typeof filterArchive === 'function') {
      const archiveBaseOrder = Math.max(0,...ARCHIVE_ALL.map(r=>Number(r._order)||0));
      updates.filter(u => u.counts_as_title_match).forEach((u, updateIndex) => {
        const record = {
          date: u.match_date,
          year: +u.match_date.slice(0,4),
          type: u.outcome === 'Transfer' ? 'transfer' : 'defence',
          main: u.holder_after,
          other: u.outcome === 'Transfer' ? u.holder_before : u.opponent,
          event: u.tournament,
          round: u.round,
          score: u.result_score,
          _order: archiveBaseOrder + 1 + updateIndex
        };
        const exists = ARCHIVE_ALL.some(r =>
          r.date === record.date &&
          r.type === record.type &&
          r.main === record.main &&
          r.other === record.other &&
          r.event === record.event &&
          r.round === record.round &&
          r.score === record.score
        );
        if (!exists) ARCHIVE_ALL.push(record);
      });
      filterArchive();
    }
  } catch (archiveError) {
    console.error('Pipeline test archive injection failed', archiveError);
  }

  const parseUTC = d => {
    const [y,m,day] = String(d).split('-').map(Number);
    return Date.UTC(y,m-1,day);
  };
  const diffDays = (a,b) => Math.max(0,Math.floor((parseUTC(b)-parseUTC(a))/86400000));
  const todayISO = () => {
    const d = new Date();
    return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${String(d.getUTCDate()).padStart(2,'0')}`;
  };
  const longDate = d => {
    const [y,m,day] = String(d).split('-').map(Number);
    return new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(Date.UTC(y,m-1,day)));
  };
  const shortDate = d => {
    const [y,m,day] = String(d).split('-').map(Number);
    return new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(Date.UTC(y,m-1,day)));
  };

  // Current hero.
  const hero = document.querySelector('#champion');
  hero.querySelector('.holder-name').textContent = state.current_holder;
  hero.querySelector('.holder-since').textContent = 'Won on ' + longDate(state.current_since);
  hero.querySelector('.holder-result').textContent = `def. ${state.won_from} · ${state.acquisition.tournament} ${state.acquisition.round || ''} · ${state.acquisition.score}`;
  document.querySelector('#daysHeld').textContent = diffDays(state.current_since,todayISO()).toLocaleString();
  const heroStats = hero.querySelectorAll('.holder-stat');
  heroStats[0].querySelector('.sub').textContent = 'Since ' + shortDate(state.current_since);
  heroStats[1].querySelector('.n').textContent = Number(state.current_defences).toLocaleString();
  heroStats[1].querySelector('.sub').textContent = state.current_defences === 1 ? '1 successful defence in current reign' : `${state.current_defences} successful defences in current reign`;
  heroStats[2].querySelector('.n').textContent = state.next_match ? shortDate(state.next_match.date) : 'TBD';
  heroStats[2].querySelector('.sub').textContent = state.next_match ? `${state.next_match.opponent} · ${state.next_match.tournament}` : 'No verified next defence yet';
  try {
    const livePlayer = (PIPELINE.players || []).find(p => p.player === state.current_holder);
    const meta = typeof HOLDER_COUNTRY_AUDIT !== 'undefined' ? HOLDER_COUNTRY_AUDIT[state.current_holder] : null;
    if (livePlayer?.flag) {
      const flagEl = document.querySelector('#champion .holder-flag, #champion [data-flag], #champion .flag');
      if (flagEl) { flagEl.textContent = livePlayer.flag; flagEl.title = livePlayer.country || ''; }
      else setChampionFlag({iso2:meta?.iso2 || '',country:livePlayer.country || meta?.country || state.current_holder,fallback:livePlayer.country_code || meta?.ioc || ''});
    } else {
      setChampionFlag({iso2:meta?.iso2 || '',country:meta?.country || state.current_holder,fallback:meta?.ioc || ''});
    }
  } catch(e) {}

  // At-a-glance totals. Holder total grows only for genuinely new holders.
  const glance = {};
  document.querySelectorAll('.glance-cell').forEach(cell => {
    glance[cell.querySelector('.glance-label')?.textContent.trim()] = cell.querySelector('.glance-number');
  });
  if (glance['Title changes']) glance['Title changes'].textContent = state.transfers.toLocaleString();
  if (glance['Successful defences']) glance['Successful defences'].textContent = state.total_defences.toLocaleString();
  if (glance['Played title matches']) glance['Played title matches'].textContent = state.played_title_matches.toLocaleString();
  if (glance['Holders']) {
    const initialNames = new Set(CHAMPION_DATA.map(p=>p.player));
    const newlySeen = new Set(updates.filter(u=>u.outcome==='Transfer').map(u=>u.holder_after).filter(n=>!initialNames.has(n)));
    glance['Holders'].textContent = (CHAMPION_DATA.length + newlySeen.size).toLocaleString();
  }

  // Last six title changes: prepend new transfers and keep six cards.
  const grid = document.querySelector('#last6 .tc-grid');
  updates.filter(u=>u.outcome==='Transfer').forEach(u=>{
    const card = document.createElement('article');
    card.className='tc-card';
    card.innerHTML = `<div class="tc-top"><div class="tc-date">${longDate(u.match_date)}</div><div class="tc-stage">${esc(u.tournament)} · ${esc(u.round || '—')}</div></div>
      <div class="tc-match"><div class="tc-player"><div class="tc-name">${esc(u.holder_before)}</div></div><div class="tc-arrow">→</div><div class="tc-player new"><div class="tc-name">${esc(u.holder_after)}</div></div></div>
      <div class="tc-result"><b>${esc(u.holder_after)} def. ${esc(u.holder_before)}</b><span>${esc(u.result_score || '')}</span></div>`;
    grid.prepend(card);
  });
  while (grid.children.length > 6) grid.lastElementChild.remove();

  // Historical year data and year rail.
  const bumpDefenceLeader = (d, player) => {
    const arr = d.defence_leaders || (d.defence_leaders=[]);
    let row = arr.find(x=>x.player===player);
    if (row) row.count += 1; else arr.push({player,count:1});
    arr.sort((a,b)=>b.count-a.count || a.player.localeCompare(b.player));
    d.defence_leaders = arr.slice(0,5);
  };
  updates.forEach(u=>{
    const y=String(u.match_date).slice(0,4);
    if(!HISTORY_YEAR_DATA[y]) HISTORY_YEAR_DATA[y]={entry:u.holder_before,exit:u.holder_after,transfers:0,defences:0,title_matches:0,defence_leaders:[],transfers_rows:[]};
    const d=HISTORY_YEAR_DATA[y];
    d.exit=u.holder_after;
    if(u.counts_as_title_match) d.title_matches=(d.title_matches||0)+1;
    if(u.outcome==='Defence'){
      d.defences=(d.defences||0)+1;
      bumpDefenceLeader(d,u.holder_after);
    }
    if(u.outcome==='Transfer'){
      d.transfers=(d.transfers||0)+1;
      d.played_transfers=(d.played_transfers||0)+1;
      d.transfers_rows=d.transfers_rows||[];
      d.transfers_rows.push({date:u.match_date,year:+y,from:u.holder_before,to:u.holder_after,event:u.tournament,round:u.round,score:u.result_score,date_status:'PIPELINE TEST',source:u.source_url,kind:'transfer'});
      const counts={};
      d.transfers_rows.forEach(r=>{counts[r.event||'—']=(counts[r.event||'—']||0)+1});
      const best=Object.entries(counts).sort((a,b)=>b[1]-a[1])[0];
      if(best) d.busiest_event={event:best[0],transfers:best[1]};
    }
  });
  initHistoryExplorer();

  // General leaderboard + holder explorer.
  const bumpLeaderboard = (metric, player, delta) => {
    const arr=LEADERBOARD_DATA[metric];
    let row=arr.find(x=>x.player===player);
    if(row) row.value += delta;
    else arr.push({player,value:delta});
    arr.sort((a,b)=>b.value-a.value || a.player.localeCompare(b.player));
    LEADERBOARD_DATA[metric]=arr.slice(0,12);
  };

  const baselineCheckpoint = state.checkpoint_date;
  const firstTransfer = updates.find(u=>u.outcome==='Transfer');
  if(firstTransfer){
    bumpLeaderboard('days', firstTransfer.holder_before, diffDays(baselineCheckpoint,firstTransfer.match_date));
    bumpLeaderboard('reigns', firstTransfer.holder_after, 1);
  }
  updates.filter(u=>u.outcome==='Defence').forEach(u=>bumpLeaderboard('defences',u.holder_after,1));

  const championByName = name => CHAMPION_DATA.find(p=>p.player===name);
  if(firstTransfer){
    const prev=championByName(firstTransfer.holder_before);
    if(prev){
      const extra=diffDays(baselineCheckpoint,firstTransfer.match_date);
      prev.days += extra;
      const active=prev.recent_reigns?.find(r=>!r.end);
      if(active){
        active.end=firstTransfer.match_date;
        active.days=diffDays(active.start,firstTransfer.match_date);
        active.ended_by=firstTransfer.holder_after;
        active.context=firstTransfer.tournament;
      }
    }
    let next=championByName(firstTransfer.holder_after);
    const currentDays=diffDays(firstTransfer.match_date,todayISO());
    if(!next){
      next={player:firstTransfer.holder_after,days:currentDays,reigns:1,defences:0,longest:currentDays,recent_reigns:[],recent_transfers:[]};
      CHAMPION_DATA.push(next);
    } else {
      next.days += currentDays;
      next.reigns += 1;
      next.longest=Math.max(next.longest,currentDays);
    }
    next.recent_reigns=[{id:'PIPELINE-TEST',holder:next.player,start:firstTransfer.match_date,end:null,days:currentDays,ended_by:null,context:'Current'},...(next.recent_reigns||[])].slice(0,5);
    next.recent_transfers=[{date:firstTransfer.match_date,year:+firstTransfer.match_date.slice(0,4),from:firstTransfer.holder_before,to:firstTransfer.holder_after,event:firstTransfer.tournament,round:firstTransfer.round,score:firstTransfer.result_score,date_status:'PIPELINE TEST',source:firstTransfer.source_url,kind:'transfer'},...(next.recent_transfers||[])].slice(0,5);
  }
  updates.filter(u=>u.outcome==='Defence').forEach(u=>{
    const p=championByName(u.holder_after);
    if(p) p.defences += 1;
    CHAMPION_DEFENCES[u.holder_after]=CHAMPION_DEFENCES[u.holder_after]||[];
    CHAMPION_DEFENCES[u.holder_after].unshift({date:u.match_date,year:+u.match_date.slice(0,4),holder:u.holder_after,opponent:u.opponent,event:u.tournament,round:u.round,score:u.result_score,number:CHAMPION_DEFENCES[u.holder_after].length+1,precision:'PIPELINE TEST',source:u.source_url});
  });

  const zeroSurface=()=>({transfers:0,defences:0,total:0});
  const ensureSurfacePlayer=name=>{
    if(!HOLDER_SURFACE_DATA[name]) HOLDER_SURFACE_DATA[name]={Hard:zeroSurface(),Clay:zeroSurface(),Grass:zeroSurface(),Carpet:zeroSurface()};
    return HOLDER_SURFACE_DATA[name];
  };
  updates.forEach(u=>{
    if(!u.counts_as_title_match || !u.surface) return;
    const prof=ensureSurfacePlayer(u.holder_after);
    const bucket=prof[u.surface] || (prof[u.surface]=zeroSurface());
    if(u.outcome==='Transfer') bucket.transfers += 1;
    if(u.outcome==='Defence') bucket.defences += 1;
    bucket.total = bucket.transfers + bucket.defences;
  });

  renderChampionList('');
  renderChampion(state.current_holder);
  renderLeaderboard(document.querySelector('.leader-tab.active')?.dataset.metric || 'days');

  // Surface leaderboard data and four summary cards.
  const bumpSurface = (metric,court,player,delta) => {
    const arr=SURFACE_LEADER_DATA[metric][court];
    let row=arr.find(x=>x.player===player);
    if(row) row.value+=delta; else arr.push({player,value:delta});
    arr.sort((a,b)=>b.value-a.value || a.player.localeCompare(b.player));
    SURFACE_LEADER_DATA[metric][court]=arr.slice(0,10);
  };
  const surfaceDelta={};
  updates.forEach(u=>{
    if(!u.counts_as_title_match||!u.surface) return;
    surfaceDelta[u.surface]=surfaceDelta[u.surface]||{transfers:0,defences:0};
    const metric=u.outcome==='Transfer'?'transfers':'defences';
    surfaceDelta[u.surface][metric]+=1;
    bumpSurface(metric,'All',u.holder_after,1);
    bumpSurface(metric,u.surface,u.holder_after,1);
  });
  document.querySelectorAll('.surface-summary-card').forEach(card=>{
    const court=card.querySelector('.surface-summary-name')?.textContent.trim();
    const d=surfaceDelta[court]; if(!d) return;
    const bs=card.querySelectorAll('.surface-summary-meta b');
    if(bs[0]) bs[0].textContent=(Number(bs[0].textContent.replaceAll(',',''))+d.transfers).toLocaleString();
    if(bs[1]) bs[1].textContent=(Number(bs[1].textContent.replaceAll(',',''))+d.defences).toLocaleString();
  });
  // Reinitialising would duplicate click listeners, so redraw current table directly.
  const activeMetric=document.querySelector('[data-surface-metric].active')?.dataset.surfaceMetric||'defences';
  const activeCourt=document.querySelector('[data-surface-court].active')?.dataset.surfaceCourt||'All';
  const rows=(SURFACE_LEADER_DATA[activeMetric]&&SURFACE_LEADER_DATA[activeMetric][activeCourt])||[];
  const rowsEl=document.getElementById('surfaceRows');
  if(rowsEl) rowsEl.innerHTML=rows.map((r,i)=>`<div class="surface-row"><div class="surface-rank">${i+1}</div><div class="surface-player">${esc(r.player)}</div><div class="surface-value">${Number(r.value).toLocaleString()}<small>${activeCourt==='All'?'all surfaces':activeCourt} · ${activeMetric==='transfers'?'title changes':'defences'}</small></div></div>`).join('');

})();

</script>
</body>
</html>